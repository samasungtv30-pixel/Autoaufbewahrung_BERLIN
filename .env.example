PORT=3100

# Render Free: HTTPS-Versand. Domain bei Resend verifizieren, API-Key nur im Server setzen.
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM_NAME=Website Autoaufbereitung
MAIL_FROM_EMAIL=website@example.de
INQUIRY_RECIPIENT=kontakt@example.de

# Alternative: MAIL_TRANSPORT=smtp auf einem Hosting mit erlaubtem SMTP-Versand.
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=website@example.de
SMTP_PASS=HIER_DAS_SMTP_PASSWORT_EINTRAGEN

# Die Absenderadresse muss beim SMTP-Anbieter erlaubt sein.
SMTP_FROM_NAME=Website Autoaufbereitung
SMTP_FROM_EMAIL=website@example.de

# SMTP_FROM_NAME / SMTP_FROM_EMAIL bleiben als Alternative zu MAIL_FROM_* kompatibel.
